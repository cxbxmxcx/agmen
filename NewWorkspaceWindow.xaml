<Window x:Class="Agmen.NewWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New workspace" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource PanelBg}" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <Label Content="Workspace _name" Target="{Binding ElementName=NameBox}"
               Foreground="{StaticResource TextPrimary}" Padding="0,0,0,6"/>
        <TextBox x:Name="NameBox" MaxLength="64" Padding="6" TextChanged="OnNameChanged"
                 Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}"
                 CaretBrush="{StaticResource TextPrimary}"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentBusy}"
                   Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource ToolButton}" Margin="0,0,8,0"/>
            <Button x:Name="OpenButton" Content="Open workspace" Click="OnOpen" IsDefault="True"
                    IsEnabled="False" Style="{StaticResource ToolButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
