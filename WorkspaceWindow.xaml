<Window x:Class="Agmen.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agmen" Width="1400" Height="880" MinWidth="720" MinHeight="420"
        Background="#FF101016" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <Style x:Key="TabItem" TargetType="ListBoxItem">
            <!-- A child's card sits indented under its parent's; a folded parent hides its children. -->
            <Setter Property="Margin" Value="{Binding TreeMargin}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource CardBg}" CornerRadius="8"
                                Padding="10,8" BorderThickness="4,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <!-- Later triggers win: the color code always owns the stripe when one is set. -->
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBusy}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnded}" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF33334A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF8E8EA8"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasCategory}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding CategoryBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HiddenByCollapse}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" MinWidth="220" MaxWidth="520"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: one card per hosted session, doubling as the tab strip -->
        <DockPanel Grid.Column="0" Background="#FF15151C">
            <Grid DockPanel.Dock="Top" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="+  New session  &#x25BE;" Style="{StaticResource ToolButton}" Click="OnNewClick"
                        ToolTip="Start Claude Code, Codex, Kimi Code or Antigravity in a folder. Ctrl+Shift+T starts the agent you picked last."/>
                <Button x:Name="PrimaryButton" Grid.Column="1" Content="&#x2605;" Style="{StaticResource ToolButton}"
                        Margin="6,0,0,0" Width="36" Click="OnPrimaryClick" MouseRightButtonUp="OnPrimaryRightClick"
                        Foreground="{StaticResource AccentPrimary}"
                        ToolTip="The primary session: reads and directs your other sessions. Right-click to choose the agent that runs it."/>
                <Button x:Name="RecentButton" Grid.Column="2" Content="&#x21BB;" Style="{StaticResource ToolButton}"
                        Margin="6,0,0,0" Width="36" Click="OnRecentClick"
                        ToolTip="Reopen earlier sessions: the session history (Ctrl+Shift+H), recent Claude Code sessions, or your saved set"/>
            </Grid>
            <Button DockPanel.Dock="Top" Content="Workspaces  &#x25BE;" HorizontalAlignment="Left" Margin="10,0,10,6"
                    Style="{StaticResource ToolButton}" Click="OnWorkspacesClick"
                    ToolTip="Create a workspace or open a saved workspace in its own window"/>
            <TextBlock x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="12,6,12,10" FontSize="11"
                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            <!-- No type-to-select: with the list focused, typed letters would jump between cards. -->
            <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0" Padding="8,0"
                     IsTextSearchEnabled="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource TabItem}"
                     SelectionChanged="OnTabSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- Status dot: amber pulse = working, blue = waiting for input, gray = not running -->
                            <Ellipse Grid.RowSpan="2" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AccentIdle}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                <Setter Property="Fill" Value="#FF6A6A7A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                                <Setter Property="Fill" Value="#FF6C9DF2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBusy}"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Pulse">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.25" Duration="0:0:0.7"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Pulse"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <DockPanel Grid.Column="1">
                                <Border x:Name="AttentionPill" DockPanel.Dock="Right" Background="{StaticResource AccentBusy}"
                                        CornerRadius="3" Padding="5,0,5,1" Margin="6,0,0,0"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="{Binding AttentionText}" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="#FF15151C"/>
                                </Border>
                                <Border x:Name="QueuePill" DockPanel.Dock="Right" Background="{StaticResource AccentPrimary}"
                                        CornerRadius="3" Padding="5,0,5,1" Margin="6,0,0,0"
                                        VerticalAlignment="Center" Visibility="Collapsed" ToolTip="{Binding QueueTooltip}">
                                    <TextBlock Text="{Binding QueueText}" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="#FF15151C"/>
                                </Border>
                                <Button DockPanel.Dock="Right" Content="{Binding ChildToggleText}" Style="{StaticResource GlyphButton}"
                                        Visibility="{Binding ChildToggleVisibility}" Click="OnCardToggleChildren"
                                        Margin="6,0,0,0" Padding="5,0" VerticalAlignment="Center"
                                        ToolTip="Fold this session's children away, or show them"/>
                                <TextBlock DockPanel.Dock="Left" Text="&#x21B3;" Margin="0,0,4,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                           Visibility="{Binding ChildMarkVisibility}"/>
                                <Border DockPanel.Dock="Left" Background="{Binding AgentBrush}" CornerRadius="3" Padding="4,0,4,1"
                                        Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding AgentBadgeVisibility}">
                                    <TextBlock Text="{Binding AgentLabel}" FontSize="9" FontWeight="SemiBold" Foreground="#FF15151C"/>
                                </Border>
                                <TextBlock x:Name="CardTitle" Text="{Binding DisplayTitle}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{Binding TitleBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Elapsed}" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailLine}" FontSize="11"
                                       Margin="0,3,0,0" Foreground="{StaticResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="&#x2715;" Style="{StaticResource GlyphButton}"
                                    Margin="8,2,0,0" ToolTip="Close tab" Click="OnCardCloseClick"/>

                            <!-- A Kimi Code or Antigravity session that started while its agent wasn't connected to this copy -->
                            <TextBlock x:Name="ToolsLine" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="No Agmen tools" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"
                                       Foreground="#FFFF9F5A" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ToolsMissingTooltip}" Visibility="Collapsed"/>

                            <TextBlock x:Name="Branch" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="{Binding BranchText}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="#FF8FBCA8" TextTrimming="CharacterEllipsis"/>

                            <TextBlock x:Name="NoteLine" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="{Binding Note}" FontSize="11" Margin="0,3,0,0" FontStyle="Italic"
                                       Foreground="#FFB7B7C9" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>

                            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,1">
                                <ProgressBar Style="{StaticResource ThinBar}"
                                             Value="{Binding Session.ContextPercent, Mode=OneWay, FallbackValue=0}"
                                             Foreground="{Binding Session.CtxBarBrush, FallbackValue={StaticResource AccentIdle}}"
                                             ToolTip="{Binding Session.CtxBarTooltip}"/>
                                <ProgressBar Style="{StaticResource ThinBar}" Margin="0,3,0,0"
                                             Value="{Binding Session.OutputPercent, Mode=OneWay, FallbackValue=0}"
                                             Foreground="{Binding Session.OutBarBrush, FallbackValue={StaticResource AccentIdle}}"
                                             ToolTip="{Binding Session.OutBarTooltip}"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                <Setter TargetName="AttentionPill" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasToolsMissing}" Value="True">
                                <Setter TargetName="ToolsLine" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasQueued}" Value="True">
                                <Setter TargetName="QueuePill" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BranchText}" Value="">
                                <Setter TargetName="Branch" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                <Setter TargetName="NoteLine" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                <Setter TargetName="CardTitle" Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FF22222C"/>

        <!-- The selected session -->
        <DockPanel Grid.Column="2" Background="#FF0C0C0C">
            <Border DockPanel.Dock="Top" Background="#FF1B1B24" Padding="14,8"
                    BorderBrush="#FF2A2A36" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RestartButton" Content="&#x21BB;  Restart" Style="{StaticResource ToolButton}"
                                Margin="8,0,0,0" Visibility="Collapsed" Click="OnRestartClick"/>
                        <Button x:Name="CloseTabButton" Content="Close tab" Style="{StaticResource ToolButton}"
                                Margin="8,0,0,0" Click="OnCloseTabClick"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="HeaderTitle" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="HeaderCategory" CornerRadius="3" Padding="6,0,6,1" Margin="10,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    ToolTip="Color code. Right-click the tab or press Ctrl+Shift+1 to 4 to change it.">
                                <TextBlock x:Name="HeaderCategoryText" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="#FF15151C"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="HeaderDetail" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid>
                <Grid x:Name="TerminalHost"/>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="No sessions open" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Start one with + New session, or reopen earlier ones from the session history: &#x21BB; or Ctrl+Shift+H."/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
