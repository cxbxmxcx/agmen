<Window x:Class="Agmen.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session history" Width="800" Height="600" MinWidth="540" MinHeight="320"
        ShowInTaskbar="False" Background="#FF101016" WindowStartupLocation="CenterOwner">

    <DockPanel Margin="18,16,18,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Session history" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Margin="0,6,0,12" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                       Text="Sessions you closed in Agmen, and every agent's sessions from the past week, including ones started elsewhere. Reopen one to continue its conversation in a tab."/>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                           Foreground="{StaticResource TextSecondary}"/>
                <TextBox x:Name="Search" TextChanged="OnSearchChanged" Padding="6,4" FontSize="12.5"
                         Background="#FF15151C" Foreground="{StaticResource TextPrimary}" BorderBrush="#FF2A2A36"
                         CaretBrush="{StaticResource TextPrimary}"
                         ToolTip="Filter by title, folder or agent"/>
            </DockPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="Close" Style="{StaticResource ToolButton}" DockPanel.Dock="Right" IsCancel="True" Click="OnClose"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondary}"/>
        </DockPanel>

        <ListBox x:Name="Rows" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                 MouseDoubleClick="OnRowDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="12,9" ToolTip="{Binding Tooltip}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button Content="{Binding ReopenText}" Style="{StaticResource ToolButton}" Click="OnReopen"/>
                                <Button Content="{Binding WithChildrenText}" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                        Visibility="{Binding WithChildrenVisibility}" Click="OnReopenWithChildren"/>
                                <Button Content="Forget" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                        Visibility="{Binding ForgetVisibility}" Click="OnForget"
                                        ToolTip="Remove it from Agmen's history. The agent keeps its conversation."/>
                            </StackPanel>
                            <Border DockPanel.Dock="Left" Background="{Binding AgentBrush}" CornerRadius="3" Padding="5,0,5,1"
                                    Margin="0,2,10,0" VerticalAlignment="Top">
                                <TextBlock Text="{Binding AgentLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#FF15151C"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
