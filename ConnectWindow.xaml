<Window x:Class="Agmen.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect agents" Width="680" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#FF101016" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="LinkToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,16,18,16">
        <TextBlock Text="Connect agents" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
        <TextBlock x:Name="Reason" Visibility="Collapsed" Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{StaticResource AccentBusy}"/>
        <TextBlock Margin="0,6,0,14" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                   Text="Kimi Code and Antigravity read Agmen's settings only from their global config. Connect adds Agmen's tool server there, lets its tools run without asking each time, and adds an agmen agent that carries Agmen's instructions; for Antigravity, also the hooks that tell Agmen when it's working. Disconnect removes exactly that. Outside Agmen they do nothing. Sessions already running pick them up when restarted: right-click the tab and choose Restart session. Claude Code and Codex need nothing here: Agmen passes them its settings when it starts them."/>

        <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="{Binding ConnectText}" Style="{StaticResource ToolButton}"
                                            IsEnabled="{Binding CanConnect}" Click="OnConnect"/>
                                    <Button Content="Disconnect" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                            IsEnabled="{Binding CanDisconnect}" Click="OnDisconnect"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding StateText}" FontSize="11.5" Margin="0,3,12,0" TextWrapping="Wrap"
                                               Foreground="{Binding StateBrush}"/>
                                </StackPanel>
                            </DockPanel>
                            <ToggleButton x:Name="ShowPreview" Content="What Connect writes  &#x25BE;" Style="{StaticResource LinkToggle}"
                                          Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,0" Padding="8"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="11" BorderThickness="0"
                                     Background="#FF15151C" Foreground="{StaticResource TextPrimary}"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     MaxHeight="260"
                                     Visibility="{Binding IsChecked, ElementName=ShowPreview, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Close" Style="{StaticResource ToolButton}" HorizontalAlignment="Right" Margin="0,4,0,0"
                IsCancel="True" Click="OnClose"/>
    </StackPanel>
</Window>
